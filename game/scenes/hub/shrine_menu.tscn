theme_override_font_sizes/font_size = 24
text = "Diwa: 0"
horizontal_alignment = 1

[node name="Upgrades" type="VBoxContainer" parent="Center/Panel/Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 6

[node name="Leave" type="Button" parent="Center/Panel/Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Leave (Esc)"
