[gd_resource type="Resource" script_class="RoomData" format=3]

[ext_resource type="Script" path="res://data/rooms/room_data.gd" id="1_room"]
[ext_resource type="Script" path="res://data/waves/wave_set.gd" id="2_set"]
[ext_resource type="Script" path="res://data/waves/wave_data.gd" id="3_wave"]
[ext_resource type="Resource" path="res://data/enemies/evil_tikbalang.tres" id="4_enemy"]
[ext_resource type="Resource" path="res://data/enemies/evil_tyanak.tres" id="5_enemy"]

[sub_resource type="Resource" id="Wave_1"]
script = ExtResource("3_wave")
enemy = ExtResource("5_enemy")
enemy_count = 12
duration = 10.0

[sub_resource type="Resource" id="Wave_2"]
script = ExtResource("3_wave")
enemy = ExtResource("5_enemy")
enemy_count = 18
duration = 12.0

[sub_resource type="Resource" id="Wave_3"]
script = ExtResource("3_wave")
enemy = ExtResource("4_enemy")
enemy_count = 3
duration = 8.0

[sub_resource type="Resource" id="Wave_4"]
script = ExtResource("3_wave")
enemy = ExtResource("5_enemy")
enemy_count = 20
duration = 12.0

[sub_resource type="Resource" id="Waves"]
script = ExtResource("2_set")
waves = Array[ExtResource("3_wave")]([SubResource("Wave_1"), SubResource("Wave_2"), SubResource("Wave_3"), SubResource("Wave_4")])

[resource]
script = ExtResource("1_room")
display_name = "Tyanak Nest"
clear_mode = 0
survive_time = 45.0
room_size = Vector2(2400, 1600)
wave_set = SubResource("Waves")
min_depth = 1
max_depth = 3
scales_with_depth = true
